[global]
font = "JetBrainsMono Nerd Font 10"
format = "<b>%s</b>\n%b"
sort = yes
indicate_hidden = yes
alignment = left
ellipsize = middle
show_age_threshold = -1
word_wrap = yes
ignore_newline = no

width = 320
height = (0, 500)
origin = top-right
offset = (10, 12)

progress_bar = true
progress_bar_height = 14
progress_bar_frame_width = 1
progress_bar_min_width = 150
progress_bar_max_width = 300

frame_width = 3
frame_color = "#1C2325"
transparency = 0
idle_threshold = 0
monitor = 0
follow = none
show_indicators = no
sticky_history = yes
line_height = 8
separator_height = 3
padding = 16
horizontal_padding = 12
text_icon_padding = 16
separator_color = frame

icon_position = left
min_icon_size = 32
max_icon_size = 48
corner_radius = 17

always_run_script = true
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
timeout = 6
background = "#0d0f16"
foreground = "#CDD6F4"
frame_color = "#191d24"
highlight = "#7ba5dd"

[urgency_normal]
timeout = 6
background = "#0d0f16"
foreground = "#CDD6F4"
frame_color = "#0d0f16"
highlight = "#7ba5dd"

# Play a sound only for critical notifications.
[urgency_critical]
script = ~/.config/dunst/scripts/playNotificationSound.sh
timeout = 6
background = "#0d0f16"
foreground = "#CDD6F4"
frame_color = "#0d0f16"
highlight = "#ee6a70"

[backlight]
appname = "BRIGHTNESS"
set_stack_tag = "backlight"

[volume]
appname = "VOLUME"
set_stack_tag = "volume"

[volume-muted]
appname = "VOLUME"
summary = "MUTED"
highlight = "#ee6a70"

[volume-unmuted]
appname = "VOLUME"
summary = "UNMUTED"
highlight = "#ee6a70"
